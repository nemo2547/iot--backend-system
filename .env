# Server
PORT=3000

# Security (WS 6)
JWT_SECRET=super-secret-key-change-this-in-production-123456

# Database (PostgreSQL)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=iot_db
DATABASE_URL=postgresql://user:password@postgres:5432/iot_db?schema=public

# Redis
REDIS_URL=redis://redis:6379

# RabbitMQ (WS 7 & 8)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://rabbitmq:5672